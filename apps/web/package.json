{
  "name": "expense-manager-next",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy:check": "npm run lint && npm run build",
    "predeploy": "npm run deploy:check",
    "supabase:init": "supabase init",
    "supabase:start": "supabase start",
    "db:schema": "psql \"$DATABASE_URL\" -f ./infra/db/schema.sql || echo \"psql not available; run schema manually\"",
    "db:seed": "psql \"$DATABASE_URL\" -f ./infra/db/seed.sql || echo \"psql not available; run seed manually\""
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.14.0",
    "@supabase/auth-helpers-react": "^0.14.0",
    "@supabase/supabase-js": "^2.36.0",
    "next": "^15.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.2.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.4.5"
  }
}
